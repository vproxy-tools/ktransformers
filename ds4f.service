[Unit]
Description=DeepSeek-V4-Flash-Vision-Exp SGLang server (ktransformers dspark-kt-fix, RTX 4090D, hybrid 3F+27U + DSpark + Soft Token Latent Reasoning + 1M ctx + CPU侧视觉推理)
Documentation=file:///home/wkgcass/ktransformers/DSv4Flash.md
After=network.target
# 若机器启用了 nvidia-persistenced，取消下面两行注释可避免冷启动时驱动未就绪
# Requires=nvidia-persistenced.service
# After=nvidia-persistenced.service

# 崩溃自动拉起的限流：权重加载约 1.5 分钟、内存占用 150GB+，
# 异常状态下无限重启会反复加载权重，故限制每天最多 500 次
StartLimitIntervalSec=86400
StartLimitBurst=500

[Service]
Type=simple
User=wkgcass
Group=wkgcass
WorkingDirectory=/home/wkgcass/ktransformers

# --- 生产栈（2026-09-08 起含 Soft Token Latent Reasoning，DSv4F-Opt.md §10）---
# venv: 仓库根 .venv（torch 2.11+cu128；sglang 为
# editable 安装，指向 third_party/sglang 的 dspark-kt-fix 分支
# （官方 main d06762282 + 自研补丁线性化谱系，见 DSv4F-Opt.md §5.18
# 补记）——不要切分支！）
#
# 与 2026-09-08 之前的生产配置的差异（其余完全一致）：
#   1. 打开 SGLANG_SOFT_THINKING=1（见下）。DSpark 保留开启：单候选 latent 步
#      与 think-end 步与普通贪心完全等价，直接走 DSpark verify（2026-09-09 起，
#      DSv4F-Opt.md §10.12）；只有多候选 latent 步（verify clamp 或 plain 拦截
#      器存下 pending soft embedding）才把下一步降级为普通 target decode
#      （dspark_worker_v2._forward_decode 顶部按 _soft_pending_count 门控），
#      消费完自动恢复投机；
#   2. radix/HiCache 均保持开启：latent 位置在缓存键序列中使用内容派生的
#      合成 int64 id（候选 token 字符串 + float32 权重位级的 blake2b，见
#      layers/soft_latent.py latent_cache_key），相同思维链前缀可命中；
#      HiCache 页哈希对宽 id 走 escape 编码（hash_binding.cpp，向后兼容
#      历史 u32 布局，已有 L3 内容不失效）。L3 prefetch 路径同样按
#      内容 key 哈希；
#   3. 显式加 --disable-overlap-schedule（SGLANG_SOFT_THINKING 下
#      server_args 本来就会强制，显式写出避免告警；latent 步的下一输入
#      在采样后才算出，overlap 流水线无法提前跑）。

# --- 架构变量（SM_89）---
Environment=FLASHINFER_CUDA_ARCH_LIST=8.9
Environment=TORCH_CUDA_ARCH_LIST=8.9+PTX

# --- 视觉模式（vision-exp 专属，2026-09-01）---
# hybrid（默认）：视觉 attn（norm1/wqkv/2D-RoPE/SDPA/wo）在 GPU bf16，
#   视觉 FFN（norm2/w1/w2）在 CPU INT8（torch._int_mm/oneDNN VNNI，
#   K 二分组静态权重点尺度 + 动态激活尺度，同 kt-kernel int8-prefill.hpp
#   的双格式方案；实测 2223-token 图 ~0.42s，对齐器输出 cos≈0.9976）。
# gpu：视觉塔全放 GPU bf16（~0.95GB 显存，~0.24s/图，与参考实现逐位一致）。
# 切换后 systemctl restart ds4f 生效。
Environment=SGLANG_DSV4_VISION_MODE=hybrid
# URL 图片磁盘缓存（2026-09-02，DSv4Flash.md §11.6）：http(s) 图片字节按
#   sha256(url) 平铺缓存到本目录，跨重启保留；仅在进程启动时检查——总大小
#   超过阈值则按 mtime 从旧到新裁剪到达标。阈值：--dsv4-image-cache-max-mb
#   > SGLANG_DSV4_IMAGE_CACHE_MAX_MB > 默认 1024MiB（0=禁用缓存）。
#   单文件上限 SGLANG_DSV4_IMAGE_MAX_BYTES（默认 64MiB）、超时
#   SGLANG_DSV4_IMAGE_FETCH_TIMEOUT（默认 30s）。
#   前缀匹配本就基于 patch 字节 hash（pad_value），与 URL 无关，无需配置。
Environment=SGLANG_DSV4_IMAGE_CACHE_DIR=/var/hicache/dsv4-image-cache

# --- 思考模式默认开启（输出侧切分由本 fork 的 serving_chat 补丁保证）---
# 单请求可用 chat_template_kwargs {"thinking": false} 覆盖关闭
Environment=SGLANG_DEFAULT_THINKING=1
# 思考等级默认 high：请求不传 reasoning_effort 时按 "high" 编码
# （official profile：low/high/max；checkpoint 自带默认是 low。
#  单请求可用请求体 reasoning_effort: "low"/"max" 覆盖）
Environment=SGLANG_DSV4_REASONING_EFFORT=high

# --- Soft Token Latent Reasoning 开关（DSv4F-Opt.md §10，2026-09-07 落地）---
# 思维链（<think>…</think>）内部不采样离散 token，而是把现有 logits 管线
# 产出的候选分布按概率加权 input embedding 作为下一位置输入；每个 latent
# 位置以 <|latent|>base64(protobuf)<|/latent|> 下发，客户端回传可在
# prefill 重建 soft embedding。部署约束：TP=1 + 非 overlap 调度
#（server_args._handle_soft_latent_thinking 校验/强制）。
Environment=SGLANG_SOFT_THINKING=1
# 单请求连续 latent 步数上限，超出强制发 </think> 回到普通解码
# （0=不限。实测 temp=0.8 难题有 2000 步不收尾的样本——这是方法特性：
# 思维链内 argmax=EOS 会被当作普通候选吞掉，不会自行终止，故生产
# 必须设兜底；2000 latent 步 ≈ 2000 个额外 decode 步，代价可控）。
Environment=SGLANG_SOFT_LATENT_MAX_STEPS=2000
# 每 latent 位置保留的候选数上限（top_k/top_p/min_p 过滤后再截断），
# 默认 4（2026-09-09 起，原 256）；另有 SGLANG_SOFT_LATENT_MIN_PROB
# 候选概率绝对下限（默认 0.05，某位置全部低于下限则回退保留 top-cap
# 个）。改 cap/下限会改变 latent 缓存键，旧 L3 中对应条目自然失效；
# 调试可另设 SGLANG_SOFT_LATENT_DEBUG=1。

# --- DSpark + SM89 回退栈必需 ---
Environment=SGLANG_RAGGED_VERIFY_MODE=static
# verify 元数据图外构建（ctx>111.4K 图内录制会损坏生成，见 DSv4Flash.md 9.3）
Environment=SGLANG_DSv4_VERIFY_META_OUT_OF_GRAPH=1
# prefill 的 indexer gather 峰值需要消碎片
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# SM89: deep_gemm (SM90+) 路径关闭，走 torch/triton 回退
Environment=SGLANG_OPT_DEEPGEMM_HC_PRENORM=0
# SM89: topk v2 kernel 用线程块集群（SM90+ only）
Environment=SGLANG_OPT_USE_TOPK_V2=0
# SM89: 索引器 logits 走 torch 回退（deep_gemm 是 SM90+）
Environment=SGLANG_FP8_PAGED_MQA_LOGITS_TORCH=1
# 索引器用 tilelang 融合内核替代上面的 torch eager 回退（SM89 实测编译通过；
# prefill 383→493 tok/s，decode 无回退。回退开关：置 0）
Environment=SGLANG_OPT_USE_TILELANG_INDEXER=1
# 部分常驻专家层用 Marlin 内核（SM89）：常驻 GPU 专家在 decode 分摊 CPU 权重
# 带宽（matmul_ogs 小 M 每层 ~762us 不可用）。回退开关：置 0
Environment=SGLANG_V4_MARLIN_PARTIAL=1
# Marlin 常驻模式下关闭"decode 全 CPU"的相位切换（Marlin decode 47.9 >
# 全 CPU 41.4；仅在 MARLIN_PARTIAL=0 时才应设回 1）
Environment=SGLANG_KT_GPU_EXPERTS_PREFILL_ONLY=0
# DSpark draft（mtp.0/1/2）专家全挪 CPU（DSv4F-Opt.md §5.11）：draft GPU 占用
# 10.37→~0.9GB，省 ~9.5GB 喂给整层；decode 步时 +1~3ms。回退开关：置 0
Environment=SGLANG_KT_DSPARK_CPU_EXPERTS=1
# CPU prefill INT8(VNNI) 镜像路径（2026-08-28 分块内核重写后转为生产开启，
# DSv4F-Opt.md §8.5）：prefill qlen≥64 的 CPU 专家 GEMM 走 VNNI，47K 实测
# 458→709 tok/s（+55%，0 GPU 专家实验实例）；decode/verify 保持 MXFP4 比特
# 不变。内存：镜像 +138.6GiB/节点 驻持久巨页。回退开关：置 0 或删除本行
#（注意：切换后需清巨页池冷转，runbook 见 DSv4F-Opt.md §8.4）。
Environment=KT_CPU_INT8_PREFILL=1
# decode 相位减少激活专家（DSv4F-Opt.md §9，2026-08-28 实测定型）：decode/verify
# 批（<64 token）对 MoE 层 3-20 只激活 top-4 路由专家（0-2 hash 层与 21-42
# 不变；prefill 全层保持 top-6）。回退开关：删除本行并重启。
# 范围/k 可调：SGLANG_KT_DECODE_TOPK_LAYERS / _K（默认 4）；
# 注意与 SGLANG_KT_DECODE_GPU_CAP_HALF 不要同开。
Environment=SGLANG_KT_DECODE_TOPK_LAYERS=3-20
# DSpark 上下文上限：0=永不禁用（长上下文也跑 DSpark）
Environment=SGLANG_DSPARK_MAX_CTX=0
# HiCache 磁盘 L3 存储目录（NVMe；勿用 /tmp——根分区已满）。配套
# --enable-hierarchical-cache 等参数见 ExecStart。
Environment=SGLANG_HICACHE_FILE_BACKEND_STORAGE_DIR=/var/hicache
# 专家分布统计（测量用，默认关闭=零开销，DSv4F-Opt.md §6.10）：
#   1) 取消下一行注释并重启服务；2) 跑真实负载；
#   3) pkill -USR2 -f 'sglang::scheduler'   → /tmp/kt-distribute.txt
#      （只发给 scheduler 进程！systemctl kill -s USR2 会打到无处理器的
#       进程导致服务退出）；4) python3 tests/analyze_dist.py 分析。
# 开启时开销实测：prefill 不变（507.8 vs 506.7），decode 步时不变。
# 【当前已启用：真实业务负载路由分布测量】测完记得注释回去并重启。
Environment=KT_EXPERT_DIST_TRACK=1

# 早期部署的 8 个 perf env 已逐一复验（DSv4Flash.md §10）：
#   4 个默认已开（FUSE_WQA_WKV / USE_JIT_NORM / USE_MULTI_STREAM_OVERLAP /
#     USE_FUSED_STORE_CACHE，environ.py EnvBool(True)，无需设置）；
#   2 个已废弃（SGLANG_KT_WOA_FP8_TRITON / SGLANG_OPT_USE_OVERLAP_STORE_CACHE，
#     新栈无读取点）；
#   2 个开启有害，禁止搬用：
#     SGLANG_OPT_MXFP4_FUSE_RSF_SHARED_ADD=1 —— 新栈无融合消费方，会静默丢掉
#       rsf=1.5（三处 GPU MoE 路径全部算错）；
#     SGLANG_KT_FP8_LMHEAD=1 —— build_lmhead_fp8 存数据竞争，两次构建产物
#       比特不同且权重重建误差 ~20×，会静默打坏 logits。

# 子进程（scheduler / tokenizer manager）与 JIT 缓存需要 HOME 和 venv PATH
Environment=HOME=/home/wkgcass
Environment=PATH=/home/wkgcass/ktransformers/.venv/bin:/usr/local/bin:/usr/bin:/bin

# --- vision-exp 视觉栈说明（2026-09-01）---
# 模型换为 /var/deepseek-v4-flash/vision-exp（config.json architectures 已改为
#   DeepseekV4VisionForCausalLM；备份 config.json.bak-pre-vision）。
# 视觉通路（模型文件 sglang/srt/models/deepseek_v4_vision.py）：
#   * LLM 主干 0-42 层完全不变（视觉塔挂在 self.vision，绝不进 model.layers）；
#   * 图片经 /v1/chat/completions 的 image_url 传入（本机路径/base64/URL 均可），
#     dsv4 encoding 把 image 块改写为 <｜deepseek_image｜> 占位符，
#     mm processor（multimodal/processors/deepseek_v4_vision.py）按参考实现
#     做 safe_resize/patch 化/N-layout 展开为 [vocab_size+type] 哨兵块，
#     调度器再把整段换成 pad_value（radix/HiCache 前缀匹配友好）；
#   * LLM 侧改动：gate.bias_vl 路由（image span token 用 bias_vl 选专家，
#     hash 层 0-2 走 (scores+bias_vl).topk，vl_routing.py 全局上下文发布）、
#     image span 内 token 的滑窗扩展为"整图双向可见"
#     （deepseek_v4_backend._extend_swa_windows_for_images，与参考
#     get_window_topk_idxs_visible 索引集逐点一致）；
#   * 分块 prefill 已恢复（chunk 1024，与 0731 稳态一致）：调度器对图片
#     span 做边界保护（PrefillAdder._mm_extend_chunk_to_spans——分界点落在
#     span 内时把本 chunk 延到 span 结束），保证 span 内双向注意力契约；
#     带图长 prompt（如 700K）按 1024-token 分多批 prefill。
# ctx 恢复 1M（1048576/1052672，与 0731 稳态一致）。视觉塔额外占用
#   hybrid ~0.4GB / gpu ~0.95GB；若长上下文 prefill OOM，优先降
#   --kt-num-gpu-experts 27→26（每 U ≈ 0.5GB）。

# --sleep-on-idle：无负载时 scheduler 在 zmq poller 上挂起（来请求立即唤醒，
#   不加延迟），消除空转 100%+ CPU；有负载时不睡。
ExecStart=/home/wkgcass/ktransformers/.venv/bin/python -m sglang.launch_server \
  --host 0.0.0.0 --port 30000 \
  --model /var/deepseek-v4-flash/vision-exp \
  --kt-weight-path /var/deepseek-v4-flash/vision-exp \
  --kt-method MXFP4 \
  --kt-expert-placement-strategy hybrid \
  --kt-num-gpu-full-layers 3 \
  --kt-num-gpu-experts 27 \
  --kt-cpuinfer 48 \
  --kt-threadpool-count 2 \
  --tensor-parallel-size 1 \
  --context-length 1048576 \
  --chunked-prefill-size 1024 \
  --max-prefill-tokens 1024 \
  --attention-backend flashinfer \
  --mem-fraction-static 0.96 \
  --max-total-tokens 1052672 \
  --max-running-requests 2 \
  --watchdog-timeout 1200 \
  --disable-shared-experts-fusion \
  --trust-remote-code \
  --disable-overlap-schedule \
  --enable-hierarchical-cache \
  --hicache-ratio 2 \
  --hicache-write-policy write_through \
  --hicache-io-backend kernel \
  --hicache-mem-layout page_first \
  --hicache-storage-backend file \
  --hicache-storage-prefetch-policy wait_complete \
  --hicache-manual-mode \
  --enable-metrics \
  --skip-server-warmup \
  --sleep-on-idle \
  --speculative-algorithm DSPARK \
  --reasoning-parser deepseek-v4 \
  --tool-call-parser deepseekv4

# 其余稳态注释（DSpark/专家放置/HiCache/MEMFRAC）同 0731 配置，详见
#   git 历史（ds4f.service @ d993589）与 DSv4Flash.md；与旧生产配置的差异
#   见文件头部清单（SGLANG_SOFT_THINKING=1 + disable-overlap-schedule，
#   其余全同）。

# 崩溃后至少等 30s 再拉起（配合上面的 StartLimit 限流）
Restart=on-failure
RestartSec=30

# 停止：先 SIGTERM 给调度器 120s 干净退出，超时连子进程一起 SIGKILL
TimeoutStopSec=120
KillMode=control-group

# 大内存 / 多线程推理进程的常规放宽
LimitMEMLOCK=infinity
LimitSTACK=infinity
LimitNOFILE=65536

# 日志进 journald（journalctl -u ds4f -f 跟踪）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ds4f

[Install]
WantedBy=multi-user.target
