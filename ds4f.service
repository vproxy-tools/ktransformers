[Unit]
Description=DeepSeek-V4-Flash SGLang server (ktransformers dspark-kt, RTX 4090D, hybrid 3F+27U + DSpark + 1M ctx 稳态)
Documentation=file:///home/wkgcass/ktransformers/DSv4Flash.md
After=network.target
# 若机器启用了 nvidia-persistenced，取消下面两行注释可避免冷启动时驱动未就绪
# Requires=nvidia-persistenced.service
# After=nvidia-persistenced.service

# 崩溃自动拉起的限流：权重加载约 1.5 分钟、内存占用 150GB+，
# 异常状态下无限重启会反复加载权重，故限制每天最多 500 次
StartLimitIntervalSec=86400
StartLimitBurst=500

[Service]
Type=simple
User=wkgcass
Group=wkgcass
WorkingDirectory=/home/wkgcass/ktransformers

# --- DSpark 投机解码栈（DSv4Flash.md 第 3.1/9 节）---
# venv: 仓库根 .venv（torch 2.11+cu128；sglang 为
# editable 安装，指向 third_party/sglang 的 dspark-kt 分支——不要切分支！）

# --- 架构变量（SM_89）---
Environment=FLASHINFER_CUDA_ARCH_LIST=8.9
Environment=TORCH_CUDA_ARCH_LIST=8.9+PTX

# --- 思考模式默认开启（输出侧切分由 dspark-kt 分支的 serving_chat 补丁保证）---
# 单请求可用 chat_template_kwargs {"thinking": false} 覆盖关闭
Environment=SGLANG_DEFAULT_THINKING=1
# 思考等级默认拉满：请求不传 reasoning_effort 时按 "max" 编码
# （official profile：low/high/max；checkpoint 自带默认是 low。
#  单请求可用请求体 reasoning_effort: "low"/"high" 覆盖降级）
Environment=SGLANG_DSV4_REASONING_EFFORT=max

# --- DSpark + SM89 回退栈必需 ---
Environment=SGLANG_RAGGED_VERIFY_MODE=static
# verify 元数据图外构建（ctx>111.4K 图内录制会损坏生成，见 DSv4Flash.md 9.3）
Environment=SGLANG_DSv4_VERIFY_META_OUT_OF_GRAPH=1
# 131072（513 页宽）prefill 的 indexer gather 峰值需要小 chunk + 消碎片
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# SM89: deep_gemm (SM90+) 路径关闭，走 torch/triton 回退
Environment=SGLANG_OPT_DEEPGEMM_HC_PRENORM=0
# SM89: topk v2 kernel 用线程块集群（SM90+ only）
Environment=SGLANG_OPT_USE_TOPK_V2=0
# SM89: 索引器 logits 走 torch 回退（deep_gemm 是 SM90+）
Environment=SGLANG_FP8_PAGED_MQA_LOGITS_TORCH=1
# 索引器用 tilelang 融合内核替代上面的 torch eager 回退（SM89 实测编译通过；
# prefill 383→493 tok/s，decode 无回退。回退开关：置 0）
Environment=SGLANG_OPT_USE_TILELANG_INDEXER=1
# 部分常驻专家层用 Marlin 内核（SM89）：常驻 GPU 专家在 decode 分摊 CPU 权重
# 带宽（matmul_ogs 小 M 每层 ~762us 不可用）。回退开关：置 0
Environment=SGLANG_V4_MARLIN_PARTIAL=1
# Marlin 常驻模式下关闭"decode 全 CPU"的相位切换（Marlin decode 47.9 >
# 全 CPU 41.4；仅在 MARLIN_PARTIAL=0 时才应设回 1）
Environment=SGLANG_KT_GPU_EXPERTS_PREFILL_ONLY=0
# DSpark draft（mtp.0/1/2）专家全挪 CPU（DSv4F-Opt.md §5.11）：draft GPU 占用
# 10.37→~0.9GB，省 ~9.5GB 喂给整层；decode 步时 +1~3ms。回退开关：置 0
Environment=SGLANG_KT_DSPARK_CPU_EXPERTS=1
# DSpark 上下文上限：batch 内任一请求上下文达到该值后整 batch 退化为普通
# decode（DSpark >256K 输出不稳定，DSv4F-Opt.md §5.17；0=永不禁用，
# 默认 262144）。【当前置 0：门控关闭，长上下文也跑 DSpark】
Environment=SGLANG_DSPARK_MAX_CTX=0
# HiCache 磁盘 L3 存储目录（NVMe；勿用 /tmp——根分区已满）。配套
# --enable-hierarchical-cache 等参数见 ExecStart。
Environment=SGLANG_HICACHE_FILE_BACKEND_STORAGE_DIR=/var/hicache
# 磁盘缓存限额（默认无限制，会长满盘）：LRU 总量上限 200G，超了驱逐到
# 90% 水位；同时保底磁盘剩余 100G。实测磁盘占用 ~11GB / 1M token。
# 【2026-08-25 起默认关闭】已切换 --hicache-manual-mode：自动写回/自动
# 预取不再发生，限额失去意义；如需恢复自动模式，去掉 --hicache-manual-mode
# 并取消下面两行注释。
# Environment=SGLANG_HICACHE_FILE_BACKEND_MAX_SIZE=200G
# Environment=SGLANG_HICACHE_FILE_BACKEND_MIN_FREE_SPACE=100G
# 专家分布统计（测量用，默认关闭=零开销，DSv4F-Opt.md §6.10）：
#   1) 取消下一行注释并重启服务；2) 跑真实负载；
#   3) pkill -USR2 -f 'sglang::scheduler'   → /tmp/kt-distribute.txt
#      （只发给 scheduler 进程！systemctl kill -s USR2 会打到无处理器的
#       进程导致服务退出）；4) python3 tests/analyze_dist.py 分析。
# 开启时开销实测：prefill 不变（507.8 vs 506.7），decode 步时不变。
# 【当前已启用：真实业务负载路由分布测量】测完记得注释回去并重启。
Environment=KT_EXPERT_DIST_TRACK=1

# 早期部署的 8 个 perf env 已逐一复验（DSv4Flash.md §10）：
#   4 个默认已开（FUSE_WQA_WKV / USE_JIT_NORM / USE_MULTI_STREAM_OVERLAP /
#     USE_FUSED_STORE_CACHE，environ.py EnvBool(True)，无需设置）；
#   2 个已废弃（SGLANG_KT_WOA_FP8_TRITON / SGLANG_OPT_USE_OVERLAP_STORE_CACHE，
#     新栈无读取点）；
#   2 个开启有害，禁止搬用：
#     SGLANG_OPT_MXFP4_FUSE_RSF_SHARED_ADD=1 —— 新栈无融合消费方，会静默丢掉
#       rsf=1.5（三处 GPU MoE 路径全部算错）；
#     SGLANG_KT_FP8_LMHEAD=1 —— build_lmhead_fp8 存数据竞争，两次构建产物
#       比特不同且权重重建误差 ~20×，会静默打坏 logits。
# SGLANG_DSV4_MODE / SGLANG_DSV4_2604_SUBMODE / SGLANG_ENABLE_THINKING 为
# 早期部署专属，本栈不需要（见 DSv4F-Opt.md 1.4）。

# 子进程（scheduler / tokenizer manager）与 JIT 缓存需要 HOME 和 venv PATH
Environment=HOME=/home/wkgcass
Environment=PATH=/home/wkgcass/ktransformers/.venv/bin:/usr/local/bin:/usr/bin:/bin

# ctx=1048576（1M 稳态，2026-08-26 定档：27U 为 1M 上下文最大可适配 U）：
#   模型 max_position_embeddings=1048576 正好顶格。阶梯实测（DSv4F-Opt.md
#   §5.19，tests/ctx_ladder.py，20→1000K 十五档三重检查）：
#   28U 通过 750K、800K prefill 中 torch OOM 崩（申请 770MiB 连续块失败）；
#   27U 从 750K 快照续测 800→1000K 全过（idle free 468→202MiB，prefill
#   218→186 tok/s，1000K 暗号回忆正确）。每 +1U ≈ -0.542GB 边际。
#   >111K verify 损坏已由 SGLANG_DSv4_VERIFY_META_OUT_OF_GRAPH=1 修复
#   （DSv4Flash.md 9.3）；DSpark >256K 损坏根因（上游 4a5d7d3）已随
#   §5.18 上游拉齐修复并经全阶梯复测干净；SGLANG_DSPARK_MAX_CTX 保持 0。
ExecStart=/home/wkgcass/ktransformers/.venv/bin/python -m sglang.launch_server \
  --host 0.0.0.0 --port 30000 \
  --model /var/deepseek-v4-flash/0731 \
  --kt-weight-path /var/deepseek-v4-flash/0731 \
  --kt-method MXFP4 \
  --kt-expert-placement-strategy hybrid \
  --kt-num-gpu-full-layers 3 \
  --kt-num-gpu-experts 27 \
  --kt-cpuinfer 48 \
  --kt-threadpool-count 2 \
  --tensor-parallel-size 1 \
  --context-length 1048576 \
  --attention-backend flashinfer \
  --mem-fraction-static 0.96 \
  --max-total-tokens 1052672 \
  --chunked-prefill-size 1024 \
  --max-prefill-tokens 1024 \
  --max-running-requests 2 \
  --watchdog-timeout 1200 \
  --disable-shared-experts-fusion \
  --trust-remote-code \
  --enable-hierarchical-cache \
  --hicache-ratio 2 \
  --hicache-write-policy write_through \
  --hicache-io-backend kernel \
  --hicache-mem-layout page_first \
  --hicache-storage-backend file \
  --hicache-storage-prefetch-policy wait_complete \
  --hicache-manual-mode \
  --enable-metrics \
  --skip-server-warmup \
  --speculative-algorithm DSPARK \
  --reasoning-parser deepseek-v4 \
  --tool-call-parser deepseekv4

# 本文件 = 唯一稳态 unit（DSpark + 3F+27U + 1M ctx + HiCache 手动快照模式；
#   2026-08-25 前曾与 no-DSpark 稳态双 unit 并存（DSv4F-Opt.md §5.10），
#   已合一；早期 DSpark 专用 unit ds4f-dspark.service 已于 2026-08-26
#   删除——DSpark 已是默认且唯一的稳态配置，历史参数见 §5.10）。
#   2026-08-25 晚 sglang 已 merge 官方 main d06762282（DSv4F-Opt.md §5.18）；
#   2026-08-26 hicache 快照恢复截断修复（§5.19，dspark-kt-fix 7f1d2e98）。
# cuda graph 默认开启（39.6 vs eager 34.3 tok/s）；前 2 步 verify 自动 eager 预热。
# 专家放置（hybrid，配合 SGLANG_V4_MARLIN_PARTIAL=1、PREFILL_ONLY=0）：前 3 个
#   MoE 层整层（hash-MoE 层，分布均匀、部分常驻无意义）+ 其余 40 层各 27 个
#   常驻专家（Marlin 计算 prefill+decode）。2026-08-23 起从
#   5F+28U 改为 3F+40U：§5.13 九组放置扫描证明放置方式对性能无可分辨影响
#   （3F+40U 实测 prefill 540.1 / decode 41.29 tok/s，为全部实测中 prefill
#   最高值）；2026-08-25 为开 512K 上下文减到 35U；2026-08-26 为开 1M
#   上下文减到 27U（28U 阶梯 800K 崩，见上文 ctx 注释与 §5.19）。
#   整层预算来自 SGLANG_KT_DSPARK_CPU_EXPERTS=1（draft 专家挪
#   CPU 省 ~9.5GB，见 §5.11）。
#   若出现长上下文 prefill OOM：减 U（每 U ≈ 0.5GB）或缩小
#   --max-total-tokens。
# 上下文容量账（历史实测）：KV 池边际 7.7KB/token（含 swa/c4/c128/state
#   侧池）；开 radix 后池容量由 profiled 值封顶（memfrac 直接决定池大小，
#   公式见 kv_cache_configurator.py _profile_available_bytes）；长上下文
#   prefill 瞬时占用随上下文增长（~1.15GB 固定 + ~1.9B/token）。
#   历史档位：512K+38U 在 450K prefill ~360K 处 OOM 崩过（avail 1.82GB），
#   512K+35U 通过；1M+28U 在 800K 崩（torch OOM 770MiB 连续块），
#   1M+27U 全阶梯通过（本配置）。容量对照与各档完整参数表见
#   DSv4F-Opt.md §5.17，1M 定档战役详见 §5.19。
#   **DSpark >256K 输出不稳定**（重复字符/复读倾向，2026-08-25 观察）：
#   根因后经定位为上游 4a5d7d3（draft tokens>4 静默 KV 损坏），已随
#   §5.18 上游拉齐修复，1M 全阶梯复测干净。SGLANG_DSPARK_MAX_CTX
#   保险丝保留可用（262144），当前置 0 跑满投机。
#   1M 实测：全阶梯 prefill 522→186 tok/s 随上下文衰减（注意力变慢）；
#   快照恢复后 750K 前缀 7s 命中 767K token（§5.19 修复后）。
#   模型 max_position_embeddings=1048576（YaRN 自 64K 外推）。
# 并发 2（2026-08-25，--max-running-requests 1→2）：KV 池 ~1.05M token，
#   装不下两个满 1M 上下文——实际是"一大一小"或两个中短文档并行；
#   两条都接近满上下文时第二条会在队列里等池空间（不会 OOM，调度器按
#   可用 token 准入）。
# HiCache 磁盘 KV 缓存（2026-08-24 起）：去掉 --disable-radix-cache 后 tree
#   cache 走 UnifiedRadixCache（FULL+SWA 双组件，上游 DSv4 专用 HiCache 栈），
#   host 池 = 2×device（--hicache-ratio 2，驻 RAM），L3 = /var/hicache 文件
#   后端（write_through 异步落盘，重启后仍可命中；wait_complete 预取）。
#   prefill 命中统计：--enable-metrics 后 /metrics 查
#   sglang:cached_tokens_total（按 device/host/storage 细分），
#   prefill 日志行 #cached-token 为每 batch 命中数。
#   回退：恢复 ds4f.service.bak-pre-hicache 并 daemon-reload + 重启。
# 【2026-08-25 起 manual mode】--hicache-manual-mode 关闭自动写回（D→H→磁盘）
#   与请求到达时的自动预取，消除 bench 干扰、快照时机完全可控；磁盘持久化
#   改为显式接口（均要求服务空闲，非空闲返回 400）：
#     POST /hicache/snapshot/save  {"path": "/var/hicache-snap1"}  # 树→磁盘+manifest
#     POST /hicache/snapshot/load  {"path": "/var/hicache-snap1"}  # flush 后按 manifest 灌回
#     POST /flush_cache                                           # 清空 GPU/host/树（不动磁盘）
#   磁盘上的页文件是纯哈希命名、不含 token 序列，manifest.json 记录树结构，
#   快照目录整体可复制/归档。恢复自动模式：去掉 --hicache-manual-mode 并恢复
#   上面两行限额 env。
# MEMFRAC 0.96：开 radix 后该值直接决定 KV 池的 profiled 上限
#   （slack = 47.02GB × (1-memfrac)，见上文"上下文 512K"段），不再是
#   纯纸面预算线——改动它就是在调 KV 池大小。
# CHUNKED-PREFILL 1024（原 512）：tilelang 索引器 + expandable_segments 下，
#   >100K 重预填充实测安全（grow_probe 到 125K 通过）。
#   若换更大 KV 占用的配置出现 >100K prefill OOM，回退 512。

# 注意：历史版本单元文件里的 perf env 不要搬回本文件——复验结论见
# DSv4Flash.md 10（尤其 FUSE_RSF_SHARED_ADD 会静默算错、KT_FP8_LMHEAD 的
# stash 构建有数据竞争）。

# 崩溃后至少等 30s 再拉起（配合上面的 StartLimit 限流）
Restart=on-failure
RestartSec=30

# 停止：先 SIGTERM 给调度器 120s 干净退出，超时连子进程一起 SIGKILL
TimeoutStopSec=120
KillMode=control-group

# 大内存 / 多线程推理进程的常规放宽
LimitMEMLOCK=infinity
LimitSTACK=infinity
LimitNOFILE=65536

# 日志进 journald（journalctl -u ds4f -f 跟踪）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ds4f

[Install]
WantedBy=multi-user.target
